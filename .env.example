# Public base URL: OAuth issuer and host of the MCP endpoint (no trailing slash).
PUBLIC_URL=https://mcp.example.com
PORT=4100
DATA_DIR=./data

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts the stored
# homeserver sessions. Changing it forces every account to be linked again.
SESSION_ENCRYPTION_KEY=

# Optional: only accounts hosted on these homeservers (z-base-32 keys, comma-separated).
ALLOWED_HOMESERVERS=

# Optional overrides.
# MCP_PATH=/mcp
# PUBKY_CAPABILITIES=/pub/pubky.app/posts/:rw
# NEXUS_URL=https://nexus.pubky.app
# PUBKY_RELAY=
# PUBKY_TESTNET=localhost
